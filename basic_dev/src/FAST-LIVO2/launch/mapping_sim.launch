<launch>
<!-- Launch file for RMUA2026 Simulator + FAST-LIVO2 -->

	<arg name="rviz" default="true" />

	<rosparam command="load" file="$(find fast_livo)/config/fast_livo2_sim.yaml" />

	<node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen">
		<rosparam file="$(find fast_livo)/config/camera_fast_livo2_sim.yaml" />
	</node>
	
	<group if="$(arg rviz)">
		<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz" />
	</group>
	
</launch>	
